# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=job_agent

# 默认模型 provider: openai / anthropic / gemini / qwen(本地 Ollama)
LLM_PROVIDER=qwen
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Gemini
GOOGLE_API_KEY=

# 本地 Qwen（Ollama）
OLLAMA_BASE_URL=http://localhost:11434

# Embedding 模型（ollama 或本地 sentence-transformers）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# RAG
FAISS_INDEX_DIR=./data/faiss
RAG_TOP_K=5
RAG_CHUNK_SIZE=200

# 终止条件
MAX_REACT_STEPS=10
TIMEOUT_SECONDS=30
MAX_BUDGET_USD=0.05

# 摘要触发轮数
SUMMARY_INTERVAL=5

# 短期记忆后端：redis（生产默认）| memory（进程内，评测/容器/无 Redis 环境）
# 评测命令会自行覆盖为 memory：每条用例独立 session，天然隔离且不依赖外部服务
MEMORY_BACKEND=redis

# ═══════════════════════════════════════════════════════════
# 评测相关（可选，见 benchmark/config.py）
# ═══════════════════════════════════════════════════════════
# 裁判模型：必须与被测模型不同，否则等于自己批改自己的作业
# JUDGE_MODEL=glm-5.3
# JUDGE_MAX_TOKENS=1024
# JUDGE_SAMPLES=1
# 评测并发数与单条超时
# CONCURRENCY=4
# CASE_TIMEOUT=180
