<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <text class="nav-title">投递记录</text>
  </view>

  <!-- 深蓝背景区 -->
  <view class="hero">
    <text class="hero-title">投递进度一目了然</text>
    <text class="hero-sub">{{totalCount > 0 ? '已记录 ' + totalCount + ' 条投递' : '暂无投递记录'}}</text>
    <text class="hero-icon">📣</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stat-row">
    <view class="card stat-card"><text class="stat-num">{{totalCount}}</text><text class="stat-label">全部投递</text></view>
    <view class="card stat-card"><text class="stat-num">{{activeCount}}</text><text class="stat-label">进行中</text></view>
    <view class="card stat-card"><text class="stat-num">{{acceptedCount}}</text><text class="stat-label">已录用</text></view>
  </view>

  <!-- 提示卡片 -->
  <view class="card tip-card" bindtap="goPc">
    <view>
      <text class="tip-title">完整投递进程管理</text>
      <text class="tip-sub">请通过 PC 端查看和编辑完整投递进程</text>
    </view>
    <text class="tip-link">前往查看 ></text>
  </view>

  <!-- 标签页 -->
  <scroll-view class="tabs" scroll-x>
    <view class="tab {{tab === index ? 'tab-active' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-tab="{{index}}" bindtap="onTab">{{item}}</view>
  </scroll-view>

  <!-- 投递列表（按状态筛选） -->
  <view class="list" wx:if="{{!error && filteredList.length > 0}}">
    <view class="card item" wx:for="{{filteredList}}" wx:key="id">
      <text class="item-title">{{item.jobTitle}}</text>
      <text class="item-meta">{{item.companyName}} · {{item.createTime}}</text>
      <text class="item-status">{{item.statusText}}</text>
    </view>
  </view>

  <view class="empty" wx:elif="{{error}}">
    <text class="empty-icon">⚠️</text>
    <text class="empty-title">加载失败</text>
    <text class="empty-sub">{{error}}</text>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">📄</text>
    <text class="empty-title">暂无投递记录</text>
    <text class="empty-sub">当前筛选条件下没有记录</text>
  </view>
</view>
