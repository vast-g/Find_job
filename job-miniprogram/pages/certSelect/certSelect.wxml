<view class="page">
  <view class="nav">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="nav-title">资格证书</text>
    <text class="nav-save" bindtap="save">保存</text>
  </view>

  <view class="head">
    <text class="head-title">资格证书</text>
    <text class="head-count">{{selected.length}}/30</text>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索证书名称" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="body">
    <scroll-view class="sidebar" scroll-y>
      <view class="side-item {{activeCategory === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="name" data-index="{{index}}" bindtap="onCategoryTap">{{item.name}}</view>
    </scroll-view>
    <scroll-view class="content" scroll-y>
      <view class="card {{selectedMap[item] ? 'selected' : ''}}" wx:for="{{categories[activeCategory].items}}" wx:key="*this" data-name="{{item}}" bindtap="onItemTap">{{item}}</view>
    </scroll-view>
  </view>
</view>
