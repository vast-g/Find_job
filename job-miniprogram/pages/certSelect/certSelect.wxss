.page { background: #fff; height: 100vh; display: flex; flex-direction: column; }
.nav { display: flex; align-items: center; padding: 20rpx 24rpx; }
.nav-back { font-size: 44rpx; color: #333; width: 60rpx; }
.nav-title { flex: 1; text-align: center; font-size: 34rpx; font-weight: 600; color: #333; }
.nav-save { color: #0B2E59; font-size: 30rpx; }
.head { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 32rpx; }
.head-title { font-size: 36rpx; font-weight: 700; color: #333; }
.head-count { font-size: 26rpx; color: #0B2E59; }
.search-bar { padding: 10rpx 32rpx; }
.search-input { background: #F5F5F5; border-radius: 30rpx; padding: 14rpx 28rpx; font-size: 26rpx; }
.body { flex: 1; display: flex; overflow: hidden; }
.sidebar { width: 25%; background: #F7F7F7; }
.side-item { padding: 28rpx 16rpx; font-size: 26rpx; color: #666; text-align: center; border-left: 4rpx solid transparent; }
.side-item.active { background: #fff; color: #0B2E59; border-left-color: #0B2E59; font-weight: 600; }
.content { flex: 1; padding: 20rpx; box-sizing: border-box; }
.card { background: #F5F5F5; border-radius: 8px; padding: 20rpx; text-align: center; font-size: 26rpx; color: #333; margin-bottom: 16rpx; }
.card.selected { background: #E8EEF7; color: #0B2E59; border: 1rpx solid #0B2E59; }
