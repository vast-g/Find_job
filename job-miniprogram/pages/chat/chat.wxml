<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <view class="nav-center">
      <text class="nav-title">智能问答</text>
      <text class="nav-sub">AI求职顾问</text>
    </view>
    <text class="nav-del" bindtap="clearChat">🗑</text>
  </view>

  <!-- 欢迎区（无消息时） -->
  <view class="welcome" wx:if="{{messages.length === 0}}">
    <view class="welcome-icon">
      <text class="headphone">🎧</text>
      <text class="ai-tag">AI</text>
    </view>
    <text class="welcome-title">你的求职知识助手</text>
    <text class="welcome-sub">从求职准备到面试技巧，随时为你解答</text>
    <view class="quick-list">
      <view class="quick-card" wx:for="{{quickQuestions}}" wx:key="*this" data-q="{{item}}" bindtap="fillQuestion">
        <text>{{item}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="msg-list" scroll-y scroll-into-view="bottom" wx:else>
    <view class="msg {{item.role === 'user' ? 'right' : 'left'}}" wx:for="{{messages}}" wx:key="index">
      <view class="msg-body">
        <text class="bubble">{{item.content}}</text>
        <view wx:if="{{item.role === 'assistant'}}" class="fb-row">
          <text class="fb-btn" data-index="{{index}}" data-rating="1" catchtap="onFeedback">👍</text>
          <text class="fb-btn" data-index="{{index}}" data-rating="0" catchtap="onFeedback">👎</text>
        </view>
      </view>
    </view>
    <view id="bottom"></view>
  </scroll-view>

  <view class="chat-error" wx:if="{{error}}">{{error}}</view>

  <!-- 底部输入框 -->
  <view class="input-bar">
    <input class="input" placeholder="输入你的求职问题…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" disabled="{{sending || analyzing}}" />
    <text wx:if="{{sending || analyzing}}" class="pending">处理中…</text>
    <text wx:else class="send-btn" bindtap="send">✈️</text>
  </view>
</view>
