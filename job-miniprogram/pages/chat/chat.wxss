page { height: 100%; }
.page { display: flex; flex-direction: column; height: 100%; }
.nav { background: #0B2E59; display: flex; align-items: center; padding: 20rpx 24rpx; }
.nav-center { flex: 1; text-align: center; display: flex; flex-direction: column; }
.nav-title { color: #fff; font-size: 34rpx; font-weight: 600; }
.nav-sub { color: #C9A45C; font-size: 22rpx; }
.nav-del { font-size: 36rpx; }
.welcome { flex: 1; padding: 60rpx 40rpx; text-align: center; overflow-y: auto; }
.welcome-icon { width: 140rpx; height: 140rpx; background: #0B2E59; border-radius: 32rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; position: relative; }
.headphone { font-size: 60rpx; }
.ai-tag { position: absolute; top: -14rpx; right: -14rpx; background: #C9A45C; color: #fff; font-size: 20rpx; border-radius: 14rpx; padding: 2rpx 12rpx; }
.welcome-title { font-size: 40rpx; font-weight: 700; margin: 36rpx 0 16rpx; display: block; }
.welcome-sub { color: #999; font-size: 26rpx; margin-bottom: 50rpx; display: block; }
.quick-list { text-align: left; }
.quick-card { background: #fff; border-radius: 12px; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); padding: 28rpx; margin-bottom: 20rpx; display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; }
.arrow { color: #bbb; font-size: 36rpx; }
.msg-list { flex: 1; padding: 20rpx; overflow-y: auto; }
.msg { display: flex; margin-bottom: 20rpx; }
.msg.right { justify-content: flex-end; }
.msg.left { justify-content: flex-start; }
.msg-body { display: flex; flex-direction: column; max-width: 70%; align-items: flex-start; }
.msg.right .msg-body { align-items: flex-end; }
.fb-row { display: flex; margin-top: 8rpx; }
.fb-btn { font-size: 26rpx; margin-right: 16rpx; padding: 2rpx 14rpx; background: #fff; border-radius: 20rpx; border: 1rpx solid #eee; }
.bubble { max-width: 100%; padding: 16rpx 22rpx; border-radius: 12rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.right .bubble { background: #0B2E59; color: #fff; }
.left .bubble { background: #fff; color: #333; }
.input-bar { display: flex; padding: 16rpx; background: #fff; align-items: center; border-top: 1rpx solid #eee; }
.input { flex: 1; border: 1rpx solid #ddd; border-radius: 30rpx; padding: 12rpx 20rpx; font-size: 28rpx; background: #F5F6FA; }
.send-btn { margin-left: 16rpx; font-size: 40rpx; }
.pending { margin-left: 16rpx; color: #999; font-size: 26rpx; }
.chat-error { padding: 16rpx 24rpx; background: #fff1e8; color: #a34317; font-size: 26rpx; flex-shrink: 0; }
