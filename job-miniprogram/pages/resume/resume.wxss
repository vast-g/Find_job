.page { background: #F5F7FA; min-height: 100vh; padding-bottom: 40rpx; }
.nav { background: #fff; display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #eee; }
.nav-back { font-size: 44rpx; color: #1F2937; width: 60rpx; }
.nav-title { flex: 1; text-align: center; font-size: 34rpx; font-weight: 600; color: #1F2937; }
.nav-right { width: 60rpx; }
.tip-bar { background: #E8EEF7; margin: 20rpx; border-radius: 12rpx; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 12rpx; }
.tip-icon { font-size: 30rpx; }
.tip-text { flex: 1; font-size: 26rpx; color: #1F2937; }
.tip-btn { background: #0B2E59; color: #fff; font-size: 24rpx; border-radius: 24rpx; padding: 6rpx 20rpx; }
.card { background: #fff; border-radius: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); margin: 20rpx; padding: 24rpx; }
.card-title-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.card-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #1F2937; }
.picker-value { font-size: 26rpx; color: #1F2937; margin-right: 8rpx; }
.edit-icon { color: #0B2E59; font-size: 30rpx; }
.help-icon { color: #9CA3AF; font-size: 26rpx; margin-right: 12rpx; border: 1rpx solid #9CA3AF; border-radius: 50%; width: 32rpx; height: 32rpx; text-align: center; line-height: 32rpx; }
.card-content { font-size: 28rpx; color: #1F2937; display: block; }
.card-sub { font-size: 24rpx; color: #9CA3AF; margin-top: 8rpx; display: block; }
.entry-block { background: #F5F7FA; border-radius: 8rpx; padding: 16rpx; margin-bottom: 12rpx; }
.entry-text { font-size: 26rpx; color: #1F2937; line-height: 1.6; display: block; word-break: break-all; }
.entry-ops { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 8rpx; }
.entry-op { font-size: 24rpx; color: #0B2E59; }
.entry-op.del { color: #E6A23C; }
.basic-card .card-head { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 90rpx; height: 90rpx; background: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 50rpx; }
.basic-info { flex: 1; }
.basic-name { display: flex; align-items: center; gap: 10rpx; }
.name { font-size: 32rpx; font-weight: 600; color: #1F2937; }
.tag { background: #E8EEF7; color: #0B2E59; font-size: 20rpx; border-radius: 8rpx; padding: 2rpx 10rpx; }
.basic-meta { font-size: 24rpx; color: #9CA3AF; margin-top: 8rpx; display: block; }
.opt-bar { display: flex; justify-content: space-between; background: #FFF7E6; border-radius: 8rpx; padding: 10rpx 14rpx; margin-bottom: 16rpx; font-size: 24rpx; color: #E6A23C; }
.opt-link { color: #E6A23C; }
.edu-row { display: flex; gap: 16rpx; align-items: center; }
.edu-logo { width: 70rpx; height: 70rpx; background: #f0f0f0; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.edu-school { font-size: 28rpx; font-weight: 600; color: #1F2937; display: block; }
.edu-meta { font-size: 24rpx; color: #9CA3AF; margin-top: 6rpx; display: block; }
.custom-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 16rpx; }
.custom-item { background: #F5F7FA; border-radius: 12rpx; padding: 24rpx; text-align: center; font-size: 24rpx; color: #1F2937; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
.dialog { width: 82%; background: #fff; border-radius: 16rpx; padding: 30rpx; max-height: 80vh; overflow-y: auto; }
.dialog-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.dialog-field { margin-bottom: 20rpx; }
.field-label { font-size: 26rpx; color: #1F2937; display: block; margin-bottom: 8rpx; }
.field-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 14rpx 16rpx; font-size: 28rpx; }
.field-textarea { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 14rpx 16rpx; font-size: 28rpx; min-height: 160rpx; width: 100%; box-sizing: border-box; }
.dialog-btns { display: flex; gap: 20rpx; margin-top: 20rpx; }
.cancel-btn { flex: 1; background: #f0f0f0; color: #333; border: none; border-radius: 8rpx; }
.save-btn { flex: 1; background: #0B2E59; color: #fff; border: none; border-radius: 8rpx; }
